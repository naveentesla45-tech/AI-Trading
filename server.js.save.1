app.get("/scan", async (req, res) => {



  try {



    const stocks = [



      "TCS.NS",

      "INFY.NS",

      "RELIANCE.NS",

      "HDFCBANK.NS",

      "ICICIBANK.NS",

      "SBIN.NS",

      "LT.NS",

      "ITC.NS"



    ];



    const results = [];



    for (const stock of stocks) {



      const analysis =

        await analyzeStock(stock);



      results.push(analysis);



    }



    results.sort((a, b) =>

      b.score - a.score

    );



    res.json({

      scanned: results.length,

      results

    });



  } catch (err) {



    res.json({

      error: err.message

    });



  }



});

